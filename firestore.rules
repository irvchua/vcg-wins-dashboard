rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function approvedEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email.matches('.*@jcmchcorp[.]com')
          || request.auth.token.email.matches('.*@veteranschoiceglobal[.]com')
        );
    }

    match /winsBoards/{boardId} {
      allow read: if true;
      allow write: if approvedEditor();

      match /records/{recordId} {
        allow read: if true;
        allow write: if approvedEditor();
      }
    }
  }
}
