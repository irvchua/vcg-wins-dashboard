rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function approvedEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email.matches('.*@jcmchcorp[.]com')
          || request.auth.token.email.matches('.*@veteranschoiceglobal[.]com')
        );
    }

    function announcementEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'admin@veteranschoiceglobal.com',
          'le.juico@veteranschoiceglobal.com',
          'fa.ramos@veteranschoiceglobal.com',
          'j.sawit@veteranschoiceglobal.com'
        ];
    }

    match /winsBoards/{boardId} {
      allow read: if true;
      allow create: if approvedEditor()
        && (!request.resource.data.keys().hasAny(['announcement']) || (
          announcementEditor()
          && request.resource.data.announcement is string
          && request.resource.data.announcement.size() <= 240
        ));
      allow update: if approvedEditor()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['announcement']) || (
          announcementEditor()
          && request.resource.data.announcement is string
          && request.resource.data.announcement.size() <= 240
        ));

      match /records/{recordId} {
        allow read: if true;
        allow write: if approvedEditor();
      }
    }

    match /taskBoards/{boardId} {
      function taskAdmin() {
        return approvedEditor() && (
          request.auth.token.email == 'admin@veteranschoiceglobal.com'
          || exists(/databases/$(database)/documents/taskBoards/$(boardId)/admins/$(request.auth.token.email))
        );
      }

      allow read, write: if taskAdmin();
      match /tasks/{taskId} {
        allow read: if taskAdmin()
          || (approvedEditor() && resource.data.assignedToEmail == request.auth.token.email);
        allow create: if taskAdmin()
          || (approvedEditor() && request.resource.data.assignedToEmail == request.auth.token.email);
        allow update: if taskAdmin()
          || (approvedEditor()
            && resource.data.assignedToEmail == request.auth.token.email
            && request.resource.data.assignedToEmail == request.auth.token.email);
        allow delete: if taskAdmin();
      }
      match /admins/{email} {
        allow read: if taskAdmin();
        allow create, update, delete: if taskAdmin()
          && email != 'admin@veteranschoiceglobal.com';
      }
      match /members/{memberId} {
        allow read: if taskAdmin()
          || (approvedEditor() && memberId == request.auth.uid);
        allow create, update: if approvedEditor()
          && memberId == request.auth.uid
          && request.resource.data.email == request.auth.token.email;
      }
    }
  }
}
