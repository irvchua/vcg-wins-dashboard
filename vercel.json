{
  "functions": {
    "api/tasks.js": {
      "maxDuration": 60
    },
    "api/overdue-reminders.js": {
      "maxDuration": 300
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/overdue-reminders",
      "schedule": "0 1 * * *"
    }
  ]
}
